// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "git": {
    "blame": {
      "show_avatar": false
    }
  },
  "search": {
    "regex": true,
    "include_ignored": true,
  },
  "file_scan_exclusions": [
    "**/.direnv",
    "**/__pycache__",
    "**/.ruff_cache",
    "**/.pytest_cache",
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
  "disable_ai": true,
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "auto_update": false,
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
    "amp-acp": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
  },
  "proxy": "",
  "inlay_hints": {
    "enabled": true,
  },
  "vim": {
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
  },
  "autosave": "on_focus_change",
  "cursor_shape": "bar",
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "terminal": {
    "font_size": 13.0,
  },
  "ui_font_family": ".SystemUIFont",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "ssh_connections": [
    {
      "host": "Syy-PC-TS",
      "args": [],
      "projects": [
        {
          "paths": ["/home/sunya/dev/k8s-scheduler"],
        },
        {
          "paths": ["/home/sunya/dev/wip-analysis-backend/./"],
        },
      ],
    },
  ],
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": true,
  "ui_font_size": 15.0,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "languages": {
    "Nix": {
      "tab_size": 2,
      "language_servers": ["nil", "!nixd"],
      "formatter": {
        "external": {
          "command": "alejandra", // or "nixfmt"
          "arguments": ["--quiet", "--"],
        },
      },
    },
    "Python": {
      "language_servers": ["ty", "ruff"],
    },
    "YAML": {
      "tab_size": 2,
    },
  },
}
