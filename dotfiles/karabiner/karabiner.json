{
    "global": {
        "check_for_updates": false,
        "show_in_menu_bar": false
    },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "[F6] Toggle Caffeinate",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "name": "caffeinate_is_active",
                                        "type": "variable_if",
                                        "value": 0
                                    }
                                ],
                                "from": { "key_code": "f6" },
                                "to": [
                                    {
                                        "set_variable": {
                                            "name": "caffeinate_is_active",
                                            "value": 1
                                        }
                                    },
                                    { "shell_command": "nohup caffeinate -di &> /dev/null & echo $! > /tmp/caffeinate.pid; osascript -e 'display notification \"Mac is Caffeinated\" with title \"Caffeinate\"'" }
                                ],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "name": "caffeinate_is_active",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": { "key_code": "f6" },
                                "to": [
                                    {
                                        "set_variable": {
                                            "name": "caffeinate_is_active",
                                            "value": 0
                                        }
                                    },
                                    { "shell_command": "if [ -f /tmp/caffeinate.pid ]; then kill $(cat /tmp/caffeinate.pid); rm /tmp/caffeinate.pid; fi; osascript -e 'display notification \"Mac is De-Caffeinated\" with title \"Caffeinate\"'" }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
